{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "disableSignUp": {
      "description": "Disable new user sign-ups globally. Default: false",
      "type": "boolean"
    },
    "session": {
      "description": "Session lifetime and refresh behaviour",
      "type": "object",
      "properties": {
        "expiresIn": {
          "description": "Session expiration time in seconds (60–2 592 000). Default: 604 800 (7 days)",
          "type": "integer",
          "minimum": 60,
          "maximum": 2592000
        },
        "updateAge": {
          "description": "How often the session is refreshed in seconds. 0 = every request. Default: 86 400 (1 day)",
          "type": "integer",
          "minimum": 0,
          "maximum": 2592000
        },
        "disableSessionRefresh": {
          "description": "Disable automatic session refresh entirely. Default: false",
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "providerEmailPassword": {
      "type": "object",
      "properties": {
        "enabled": {
          "description": "Enable email/password authentication. Default: true",
          "type": "boolean"
        },
        "config": {
          "type": "object",
          "properties": {
            "minPasswordLength": {
              "description": "Minimum password length (4–256). Default: 8",
              "type": "integer",
              "minimum": 4,
              "maximum": 256
            },
            "requireEmailVerification": {
              "description": "Require email verification on sign-up. Default: false",
              "type": "boolean"
            },
            "requirePasswordResetEmailVerification": {
              "description": "Require email verification for password reset. Default: false",
              "type": "boolean"
            },
            "revokeSessionsOnPasswordReset": {
              "description": "Revoke all sessions when password is reset. Default: false. With JWT session cookie cache enabled, already-open browser contexts may take up to the cache TTL to reflect the revocation.",
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "providerGoogle": {
      "type": "object",
      "properties": {
        "enabled": {
          "description": "Enable Google OAuth 2.0 provider. Default: false",
          "type": "boolean"
        },
        "config": {
          "type": "object",
          "properties": {
            "clientId": {
              "description": "OAuth Client ID",
              "type": "string"
            },
            "clientIdVarRef": {
              "description": "Fixed plain var key name: \"GOOGLE_CLIENT_ID\". Store the value via `edgespark var set GOOGLE_CLIENT_ID=...`",
              "type": "string",
              "const": "GOOGLE_CLIENT_ID"
            },
            "clientSecretRef": {
              "description": "Fixed secret key name: \"GOOGLE_CLIENT_SECRET\". Store the value via `edgespark secret set GOOGLE_CLIENT_SECRET`",
              "type": "string",
              "const": "GOOGLE_CLIENT_SECRET"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "if": {
        "properties": {
          "enabled": {
            "const": true
          }
        },
        "required": [
          "enabled"
        ]
      },
      "then": {
        "required": [
          "config"
        ],
        "properties": {
          "config": {
            "type": "object",
            "allOf": [
              {
                "anyOf": [
                  {
                    "required": [
                      "clientId"
                    ]
                  },
                  {
                    "required": [
                      "clientIdVarRef"
                    ]
                  }
                ]
              },
              {
                "required": [
                  "clientSecretRef"
                ]
              }
            ]
          }
        }
      }
    },
    "providerApple": {
      "type": "object",
      "properties": {
        "enabled": {
          "description": "Enable Apple Sign-In provider. Default: false",
          "type": "boolean"
        },
        "config": {
          "type": "object",
          "properties": {
            "clientId": {
              "description": "OAuth Client ID",
              "type": "string"
            },
            "clientIdVarRef": {
              "description": "Fixed plain var key name: \"APPLE_CLIENT_ID\". Store the value via `edgespark var set APPLE_CLIENT_ID=...`",
              "type": "string",
              "const": "APPLE_CLIENT_ID"
            },
            "clientSecretRef": {
              "description": "Fixed secret key name: \"APPLE_CLIENT_SECRET\". Store the value via `edgespark secret set APPLE_CLIENT_SECRET`",
              "type": "string",
              "const": "APPLE_CLIENT_SECRET"
            },
            "appBundleIdentifier": {
              "description": "Apple app bundle identifier (e.g., com.example.app)",
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "if": {
        "properties": {
          "enabled": {
            "const": true
          }
        },
        "required": [
          "enabled"
        ]
      },
      "then": {
        "required": [
          "config"
        ],
        "properties": {
          "config": {
            "type": "object",
            "allOf": [
              {
                "anyOf": [
                  {
                    "required": [
                      "clientId"
                    ]
                  },
                  {
                    "required": [
                      "clientIdVarRef"
                    ]
                  }
                ]
              },
              {
                "required": [
                  "clientSecretRef"
                ]
              }
            ]
          }
        }
      }
    },
    "providerMicrosoft": {
      "type": "object",
      "properties": {
        "enabled": {
          "description": "Enable Microsoft (Entra ID) provider. Default: false",
          "type": "boolean"
        },
        "config": {
          "type": "object",
          "properties": {
            "clientId": {
              "description": "OAuth Client ID",
