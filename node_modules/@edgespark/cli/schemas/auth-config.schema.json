            "clientSecretRef": {
              "description": "Fixed secret key name: \"GITLAB_CLIENT_SECRET\". Store the value via `edgespark secret set GITLAB_CLIENT_SECRET`",
              "type": "string",
              "const": "GITLAB_CLIENT_SECRET"
            }
          },
          "additionalProperties": false
