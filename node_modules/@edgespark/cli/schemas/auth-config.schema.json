  "additionalProperties": false,
  "$id": "https://schemas.edgespark.dev/v1/auth-config.schema.json",
  "title": "EdgeSpark Auth Config",
  "description": "Configuration schema for EdgeSpark Sidecar authentication. Use with `edgespark auth apply -f <file>` to apply auth settings to your project."
