            "clientSecretRef": {
              "description": "Fixed secret key name: \"MICROSOFT_CLIENT_SECRET\". Store the value via `edgespark secret set MICROSOFT_CLIENT_SECRET`",
              "type": "string",
              "const": "MICROSOFT_CLIENT_SECRET"
            },
            "tenantId": {
              "description": "Azure AD Tenant ID. Default: 'common' (multi-tenant)",
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "if": {
        "properties": {
          "enabled": {
            "const": true
          }
        },
        "required": [
          "enabled"
        ]
      },
      "then": {
        "required": [
          "config"
        ],
        "properties": {
          "config": {
            "type": "object",
            "allOf": [
              {
                "anyOf": [
                  {
                    "required": [
                      "clientId"
                    ]
                  },
                  {
                    "required": [
                      "clientIdVarRef"
                    ]
                  }
                ]
              },
              {
                "required": [
                  "clientSecretRef"
                ]
              }
            ]
          }
        }
      }
    },
