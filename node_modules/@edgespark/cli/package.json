{
  "name": "@edgespark/cli",
  "version": "0.0.21",
  "description": "EdgeSpark CLI - Create and manage your EdgeSpark projects",
  "type": "module",
  "bin": {
    "edgespark": "./dist/cli.js"
  },
  "files": [
    "dist/cli.js",
    "dist/d1-interceptor.mjs",
    "dist/sidecar-bundle.js",
    "dist/auth-schemas/",
    "dist/user-worker-framework.js",
    "dist/user-worker-runtime/",
    "templates/",
    "schemas/"
  ],
  "scripts": {
    "build": "npm run build:artifacts && npm test && npm run build:cli",
    "build:artifacts": "node scripts/build-artifacts.js",
    "build:cli": "node scripts/build-cli.js",
    "prepublishOnly": "npm run build && npm run copy-templates",
    "postpublish": "rm -rf templates && ln -s ../templates templates",
    "copy-templates": "rm -rf templates && mkdir -p templates && rsync -aL --exclude='node_modules' --exclude='dist' --exclude='package-lock.json' ../templates/server templates/ && rsync -aL --exclude='node_modules' --exclude='dist' --exclude='package-lock.json' ../templates/web templates/",
    "link": "npm run build && npm link",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "edgespark",
    "cli",
    "scaffold",
    "backend",
    "hono",
    "drizzle",
    "web",
    "frontend",
    "server"
  ],
  "author": "EdgeSpark",
  "license": "MIT",
  "dependencies": {
    "ajv": "^8.18.0",
    "diff": "^8.0.4",
    "esbuild": "^0.27.1",
    "giget": "^3.2.0",
    "http-proxy": "^1.18.1",
    "jiti": "^2.6.1",
    "js-yaml": "^4.1.1",
    "mime-types": "^3.0.2",
    "miniflare": "^4.20260317.2",
    "proper-lockfile": "^4.1.2",
    "tar": "^7.5.13",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@iarna/toml": "^2.2.5",
    "@types/diff": "^7.0.2",
    "@types/fs-extra": "^11.0.4",
    "@types/http-proxy": "^1.17.15",
    "@types/js-yaml": "^4.0.9",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^25.0.2",
    "@types/proper-lockfile": "^4.1.4",
    "@types/tar": "^7.0.87",
    "chalk": "^5.6.2",
    "commander": "^14.0.2",
    "drizzle-orm": "^0.45.1",
    "es-module-lexer": "^2.0.0",
    "fs-extra": "^11.3.2",
    "hono": "^4.11.1",
    "node-sql-parser": "^5.3.13",
    "open": "^11.0.0",
    "ora": "^9.0.0",
    "simple-update-notifier": "^2.0.0",
    "vitest": "^4.0.15"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
