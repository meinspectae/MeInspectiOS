<?xml version="1.0" encoding="utf-8"?>
<!--
    Data extraction rules for Android 12+ (API 31+).
    Controls what data is included in cloud backups and device-to-device transfers.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude all shared preferences (auth tokens, session data) -->
        <exclude domain="sharedpref" path="." />
        <!-- Exclude databases -->
        <exclude domain="database" path="." />
        <!-- Exclude cache -->
        <exclude domain="cache" path="." />
    </cloud-backup>
    <device-transfer>
        <!-- Exclude all shared preferences -->
        <exclude domain="sharedpref" path="." />
        <!-- Exclude databases -->
        <exclude domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
